#!/usr/bin/env bash
# DDM wrapper for the local Godogen fork.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
ASSET_GEN="${GODOGEN_DDM_ASSET_GEN:-$ROOT/shared/skills/godogen/tools/asset_gen.py}"

usage() {
    cat >&2 <<'EOF'
Usage:
  godogen-ddm check-env
  godogen-ddm publish --engine godot|bevy|babylon --agent claude|codex --out <dir> [--force] [--video_hook]
  godogen-ddm asset image|texture|video|glb|rig|retarget|resume|set_budget ...
  godogen-ddm smoke
  godogen-ddm external-smoke [--out <dir>] [--poll <seconds>] [--yes-charge]
EOF
}

first_line() {
    sed -n '1p'
}

tool_status() {
    local label="$1"
    shift
    local binary="$1"
    local output
    local status

    if ! command -v "$binary" >/dev/null 2>&1; then
        printf '%s: missing\n' "$label"
        return
    fi

    set +e
    output="$("$@" 2>&1)"
    status=$?
    set -e
    output="$(printf '%s\n' "$output" | first_line)"
    if [ -z "$output" ]; then
        output="available"
    fi
    if [ "$status" -eq 0 ]; then
        printf '%s: %s\n' "$label" "$output"
    else
        printf '%s: error: %s\n' "$label" "$output"
    fi
}

dreamina_status() {
    local dreamina_bin
    if ! dreamina_bin="$(dreamina_bin_path)"; then
        printf 'dreamina: missing\n'
        return
    fi

    local output
    output="$("$dreamina_bin" --version 2>&1 || true)"
    output="$(printf '%s\n' "$output" | sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | first_line)"
    if [ -z "$output" ]; then
        output="available"
    fi
    printf 'dreamina: %s\n' "$output"
}

dreamina_bin_path() {
    local dreamina_bin="${GODOGEN_DREAMINA_BIN:-}"
    if [ -z "$dreamina_bin" ]; then
        if command -v dreamina >/dev/null 2>&1; then
            dreamina_bin="$(command -v dreamina)"
        elif [ -x /Users/ddm/.local/bin/dreamina ]; then
            dreamina_bin="/Users/ddm/.local/bin/dreamina"
        fi
    fi

    if [ -z "$dreamina_bin" ] || [ ! -x "$dreamina_bin" ]; then
        return 1
    fi

    printf '%s\n' "$dreamina_bin"
}

env_status() {
    local name="$1"
    eval "local value=\${$name:-}"
    if [ -n "$value" ]; then
        printf '%s=set\n' "$name"
    else
        printf '%s=unset\n' "$name"
    fi
}

cmd_check_env() {
    tool_status dotnet dotnet --version
    tool_status godot godot --version
    tool_status magick magick --version
    tool_status ffmpeg ffmpeg -version
    dreamina_status

    env_status GODOGEN_IMAGE_PROVIDER
    env_status GODOGEN_VIDEO_PROVIDER
    env_status GODOGEN_DREAMINA_BIN
    env_status GOOGLE_API_KEY
    env_status XAI_API_KEY
    env_status OPENAI_API_KEY
    env_status TRIPO3D_API_KEY
}

cmd_publish() {
    "$ROOT/publish.sh" "$@"
}

cmd_asset() {
    if [ $# -lt 1 ]; then
        usage
        exit 1
    fi

    case "$1" in
        image|texture|video|glb|rig|retarget|resume|set_budget)
            python3 "$ASSET_GEN" "$@"
            ;;
        *)
            echo "error: unknown asset subcommand: $1" >&2
            usage
            exit 1
            ;;
    esac
}

run_with_timeout() {
    local seconds="$1"
    shift
    local pid
    local i

    "$@" &
    pid=$!
    for i in $(seq 1 "$seconds"); do
        if ! kill -0 "$pid" 2>/dev/null; then
            wait "$pid"
            return $?
        fi
        sleep 1
    done

    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
    return 124
}

cmd_godot_csharp_smoke() {
    local project="$1/godot-csharp"
    local sdk_version
    local target_framework

    sdk_version="$(godot --headless --version | sed -n 's/^\([0-9][0-9]*\)\.\([0-9][0-9]*\).*/\1.\2.0/p' | sed -n '1p')"
    target_framework="net$(dotnet --version | cut -d. -f1).0"

    if [ -z "$sdk_version" ]; then
        echo "error: could not detect Godot SDK version" >&2
        return 1
    fi

    mkdir -p "$project/scripts" "$project/scenes"

    cat > "$project/project.godot" <<EOF
; Engine configuration file
; Do not edit manually

config_version=5

[application]

config/name="GodogenCSharpSmoke"
run/main_scene="res://scenes/main.tscn"

[dotnet]

project/assembly_name="GodogenCSharpSmoke"
EOF

    cat > "$project/GodogenCSharpSmoke.csproj" <<EOF
<Project Sdk="Godot.NET.Sdk/$sdk_version">
  <PropertyGroup>
    <TargetFramework>$target_framework</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
</Project>
EOF

    cat > "$project/scripts/SmokeNode.cs" <<'EOF'
using Godot;

public partial class SmokeNode : Node
{
    public override void _Ready()
    {
        GD.Print("godogen csharp smoke");
    }
}
EOF

    cat > "$project/scenes/main.tscn" <<'EOF'
[gd_scene format=3]

[node name="Main" type="Node"]
EOF

    dotnet build "$project/GodogenCSharpSmoke.csproj" > "$project/dotnet-build.log" 2>&1
    run_with_timeout 20 godot --headless --path "$project" --quit > "$project/godot-headless.log" 2>&1

    printf 'godot-csharp: ok (%s)\n' "$project"
}

cmd_smoke() {
    local tmp
    tmp="$(mktemp -d /tmp/godogen-ddm-smoke.XXXXXX)"

    python3 -m py_compile "$ASSET_GEN" "$ROOT"/shared/skills/godogen/tools/providers/*.py
    "$ROOT/bin/godogen-ddm" publish --engine godot --agent codex --out "$tmp" >/dev/null
    test -f "$tmp/AGENTS.md"
    test -f "$tmp/.agents/skills/godogen/SKILL.md"
    test -f "$tmp/.agents/skills/godot-api/SKILL.md"
    test -f "$tmp/.codex/hooks/capture_result.sh"

    "$ROOT/bin/godogen-ddm" asset texture \
        --procedural-kind checker \
        --prompt "smoke checker tile" \
        -o "$tmp/assets/img/smoke_checker.png" >/dev/null

    "$ROOT/bin/godogen-ddm" asset video \
        --provider dreamina --dry-run \
        --prompt "smoke camera push" \
        --image "$tmp/assets/img/smoke_checker.png" \
        --duration 4 --resolution 720p --poll 1 \
        -o "$tmp/assets/video/smoke.mp4" >/dev/null

    cmd_godot_csharp_smoke "$tmp"

    printf 'smoke: ok (%s)\n' "$tmp"
}

external_smoke_run_asset() {
    local label="$1"
    shift
    local stdout_file="$out/.${label}.stdout"
    local stderr_file="$out/.${label}.stderr"
    local status

    set +e
    "$@" > "$stdout_file" 2> "$stderr_file"
    status=$?
    set -e

    python3 - "$label" "$status" "$stdout_file" <<'PY'
import json
import sys
from pathlib import Path

label = sys.argv[1]
status = int(sys.argv[2])
stdout_path = Path(sys.argv[3])
text = stdout_path.read_text(errors="replace") if stdout_path.exists() else ""

payload = None
for line in reversed(text.splitlines()):
    line = line.strip()
    if not (line.startswith("{") and line.endswith("}")):
        continue
    try:
        parsed = json.loads(line)
    except json.JSONDecodeError:
        continue
    if isinstance(parsed, dict):
        payload = parsed
        break

if payload is None:
    print(f"{label}: failed exit={status}")
    sys.exit(1)

path = payload.get("path") or ""
if payload.get("ok") is True:
    suffix = f" {path}" if path else ""
    print(f"{label}: ok{suffix}")
    sys.exit(0)

if payload.get("pending") is True:
    identifier = payload.get("submit_id") or payload.get("video_id") or payload.get("task_id") or ""
    suffix = f" {identifier}" if identifier else ""
    print(f"{label}: pending{suffix}")
    sys.exit(1)

error = payload.get("error") or f"exit={status}"
print(f"{label}: failed {error}")
sys.exit(1)
PY
}

cmd_external_smoke() {
    local yes_charge=0
    local poll=5
    local out=""
    local missing=0
    local first_frame
    local dreamina_video
    local openai_video
    local openai_image
    local tripo_glb
    local incomplete=0

    while [ $# -gt 0 ]; do
        case "$1" in
            --yes-charge) yes_charge=1; shift ;;
            --out)
                if [ $# -lt 2 ]; then
                    echo "error: --out requires a directory" >&2
                    exit 1
                fi
                out="$2"
                shift 2
                ;;
            --poll)
                if [ $# -lt 2 ]; then
                    echo "error: --poll requires seconds" >&2
                    exit 1
                fi
                poll="$2"
                shift 2
                ;;
            -h|--help)
                cat >&2 <<'EOF'
Usage:
  godogen-ddm external-smoke [--out <dir>] [--poll <seconds>] [--yes-charge]

Default mode is non-paid: it creates a procedural first frame and validates
Dreamina/OpenAI command construction with dry-runs. Tripo3D has no dry-run
provider path, so it is skipped unless --yes-charge is supplied.

--yes-charge submits real provider tasks and may consume Dreamina credits,
OpenAI API billing, and Tripo3D credits. It requires Dreamina CLI availability,
OPENAI_API_KEY, and TRIPO3D_API_KEY. Provider pending/failed states are
summarized without echoing raw provider logs or secret values.
EOF
                return 0
                ;;
            *)
                echo "error: unknown external-smoke option: $1" >&2
                exit 1
                ;;
        esac
    done

    if [ -z "$out" ]; then
        out="$(mktemp -d /tmp/godogen-ddm-external-smoke.XXXXXX)"
    fi

    mkdir -p "$out/assets/img" "$out/assets/video" "$out/assets/glb"
    first_frame="$out/assets/img/external_smoke_first.png"
    dreamina_video="$out/assets/video/dreamina_external_smoke.mp4"
    openai_video="$out/assets/video/openai_external_smoke.mp4"
    openai_image="$out/assets/img/openai_external_smoke.png"
    tripo_glb="$out/assets/glb/tripo_external_smoke.glb"

    "$ROOT/bin/godogen-ddm" asset texture \
        --procedural-kind checker \
        --prompt "external provider smoke checker first frame" \
        -o "$first_frame" >/dev/null

    if [ "$yes_charge" -eq 0 ]; then
        "$ROOT/bin/godogen-ddm" asset video \
            --provider dreamina --dry-run \
            --prompt "external smoke camera push" \
            --image "$first_frame" \
            --duration 4 --resolution 720p --poll "$poll" \
            -o "$dreamina_video" >/dev/null

        "$ROOT/bin/godogen-ddm" asset image \
            --provider openai --dry-run \
            --prompt "external smoke clean top-down stone tile" \
            --aspect-ratio 1:1 \
            -o "$openai_image" >/dev/null

        "$ROOT/bin/godogen-ddm" asset video \
            --provider openai --dry-run \
            --prompt "external smoke camera push across a stone floor" \
            --image "$first_frame" \
            --duration 4 --resolution 720p --poll "$poll" \
            -o "$openai_video" >/dev/null

        printf 'external-smoke: dry-run (%s)\n' "$out"
        printf 'procedural-first-frame: ok %s\n' "$first_frame"
        printf 'dreamina-video: dry-run %s\n' "$dreamina_video"
        printf 'openai-image: dry-run %s\n' "$openai_image"
        printf 'openai-video: dry-run %s\n' "$openai_video"
        printf 'tripo3d-glb: skipped (no non-paid dry-run path)\n'
        printf 'Use --yes-charge to submit real Dreamina/OpenAI/Tripo3D provider tasks.\n'
        return 0
    fi

    if ! dreamina_bin_path >/dev/null 2>&1; then
        echo "dreamina=missing" >&2
        missing=1
    fi
    if [ -z "${OPENAI_API_KEY:-}" ]; then
        echo "OPENAI_API_KEY=missing" >&2
        missing=1
    fi
    if [ -z "${TRIPO3D_API_KEY:-}" ]; then
        echo "TRIPO3D_API_KEY=missing" >&2
        missing=1
    fi
    if [ "$missing" -ne 0 ]; then
        echo "external-smoke: refusing paid provider run until prerequisites are present" >&2
        return 2
    fi

    external_smoke_run_asset dreamina-video "$ROOT/bin/godogen-ddm" asset video \
        --provider dreamina \
        --prompt "external smoke camera push" \
        --image "$first_frame" \
        --duration 4 --resolution 720p --poll "$poll" \
        -o "$dreamina_video" || incomplete=1

    external_smoke_run_asset openai-image "$ROOT/bin/godogen-ddm" asset image \
        --provider openai \
        --prompt "external smoke clean top-down stone tile" \
        --aspect-ratio 1:1 \
        -o "$openai_image" || incomplete=1

    external_smoke_run_asset openai-video "$ROOT/bin/godogen-ddm" asset video \
        --provider openai \
        --prompt "external smoke camera push across a stone floor" \
        --image "$first_frame" \
        --duration 4 --resolution 720p --poll "$poll" \
        -o "$openai_video" || incomplete=1

    external_smoke_run_asset tripo3d-glb "$ROOT/bin/godogen-ddm" asset glb \
        --image "$first_frame" \
        -o "$tripo_glb" || incomplete=1

    printf 'procedural-first-frame: ok %s\n' "$first_frame"
    if [ "$incomplete" -ne 0 ]; then
        printf 'external-smoke: incomplete (%s)\n' "$out"
        return 1
    fi
    printf 'external-smoke: paid-run (%s)\n' "$out"
}

if [ $# -lt 1 ]; then
    usage
    exit 1
fi

cmd="$1"
shift

case "$cmd" in
    check-env) cmd_check_env "$@" ;;
    publish) cmd_publish "$@" ;;
    asset) cmd_asset "$@" ;;
    smoke) cmd_smoke "$@" ;;
    external-smoke) cmd_external_smoke "$@" ;;
    -h|--help|help) usage ;;
    *)
        echo "error: unknown command: $cmd" >&2
        usage
        exit 1
        ;;
esac
