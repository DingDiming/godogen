{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "example.png"
    }
  },
  "2": {
    "class_type": "WanImageToVideoApi",
    "inputs": {
      "model": "wan2.5-i2v-preview",
      "image": ["1", 0],
      "prompt": "slow clockwise turntable, static camera",
      "negative_prompt": "",
      "resolution": "480P",
      "duration": 5,
      "seed": 0,
      "generate_audio": false,
      "prompt_extend": false,
      "watermark": false,
      "shot_type": "single"
    }
  },
  "3": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["2", 0],
      "filename_prefix": "video/godogen/image_to_video",
      "format": "mp4",
      "codec": "h264"
    }
  }
}
