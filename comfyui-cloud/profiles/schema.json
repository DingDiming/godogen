{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Godogen ComfyUI Cloud Workflow Profile",
  "type": "object",
  "required": [
    "id",
    "asset_kind",
    "workflow",
    "inputs",
    "outputs",
    "timeout_seconds",
    "paid"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "asset_kind": {
      "type": "string",
      "enum": ["image", "texture", "video", "model3d", "analyze"]
    },
    "workflow": {
      "type": "string"
    },
    "inputs": {
      "type": "object"
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["node", "kind", "extensions"],
        "properties": {
          "node": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "extensions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "paid": {
      "type": "boolean"
    }
  }
}
